// This Prisma schema was generated for ShadeX CRM - Backend API
// Database: SQLite
// 
// Nota importante: Este esquema usa strings en lugar de enums porque SQLite no soporta enums.
// Los valores válidos se documentan en los comentarios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELO: User (Usuario del sistema)
// ============================================
model User {
  id            String   @id @default(uuid())
  email         String   @unique // Correo electrónico único
  passwordHash  String    // Hash de la contraseña (bcrypt)
  name          String   // Nombre completo del usuario
  avatar        String?   // URL de la imagen de perfil
  role          String   @default("USER") // Roles: ADMIN, USER
  
  // Relaciones
  tasks         Task[]
  supportCases   SupportCase[]
  transformations Transformation[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("users")
  
  @@index([email])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================

// ============================================
// MODELO: Client (Cliente o empresa)
// ============================================
model Client {
  id              String   @id @default(uuid())
  name            String   // Nombre de la empresa/cliente
  email           String?  // Correo electrónico del contacto principal
  phone           String?  // Teléfono de contacto
  address         String?  // Dirección completa
  city            String?  // Ciudad
  state           String?  // Estado/Provincia
  country         String?  // País
  website         String?  // Sitio web
  status          String   @default("POTENTIAL") // Valores: POTENTIAL, ACTIVE, INACTIVE
  
  // Relaciones
  quotations      Quotation[]
  supportCases    SupportCase[]
  transformations  Transformation[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("clients")
  
  @@index([status])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================

// ============================================
// MODELO: Technology (Tecnología/Software)
// ============================================
model Technology {
  id            String   @id @default(uuid())
  name          String   // Nombre de la tecnología/software
  description   String?  // Descripción breve
  category      String?  // Categoría (CRM, ERP, DevOps, etc.)
  url           String?  // URL del sitio web oficial
  version       String?  // Versión actual
  
  // Relaciones
  transformations Transformation[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("technologies")
}

// ============================================
// MODELO: Document (Documento adjunto)
// ============================================
model Document {
  id          String   @id @default(uuid())
  name        String   // Nombre del archivo
  url         String   // URL al archivo en el almacenamiento
  mimeType    String?  // Tipo MIME del archivo
  size        Int?     // Tamaño en bytes
  
  // Relaciones
  transformation Transformation?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("documents")
}

// ============================================
// MODELO: Quotation (Cotización)
// ============================================
model Quotation {
  id              String   @id @default(uuid())
  
  title           String   // Título de la cotización
  description     String?  // Descripción detallada
  
  price           Float    @default(0) // Precio total
  currency        String   @default("USD") // Moneda (USD, MXN, EUR, etc.)
  
  status          String   @default("DRAFT") // Valores: DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  expiresAt       DateTime? // Fecha de caducidad
  
  documents       Document[]
  
  client          Client   @relation("ClientQuotations")
  technology      Technology? @relation("TechnologyQuotations")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("quotations")
  
  @@index([status])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================

// ============================================
// MODELO: SupportCase (Caso de soporte)
// ============================================
model SupportCase {
  id              String   @id @default(uuid())
  client          Client?  @relation("SupportCaseClient", fields: [clientId], references: [id])
  clientId        String?  @unique // Clave foránea al cliente
  
  user            User     // Usuario asignado al caso
  
  title           String   // Título del caso
  description     String?  // Descripción detallada
  status          String   @default("OPEN") // Valores: OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  
  priority        String   @default("MEDIUM") // Valores: LOW, MEDIUM, HIGH
  
  documents       Document[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("support_cases")
  
  @@index([status])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================

// ============================================
// MODELO: Task (Tarea)
// ============================================
model Task {
  id              String   @id @default(uuid())
  client          Client?  @relation("TaskClient", fields: [clientId], references: [id])
  clientId        String?  // Clave foránea al cliente
  
  assignedTo      User?    // Usuario asignado a la tarea
  
  title           String   // Título de la tarea
  description     String?  // Descripción detallada
  status          String   @default("TODO") // Valores: TODO, IN_PROGRESS, DONE
  
  priority        String   @default("MEDIUM") // Valores: LOW, MEDIUM, HIGH
  
  dueDate         DateTime? // Fecha límite
  
  documents       Document[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("tasks")
  
  @@index([status])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================

// ============================================
// MODELO: Space (Espacio de trabajo)
// ============================================
model Space {
  id              String   @id @default(uuid())
  name            String   // Nombre del espacio
  
  description     String?  // Descripción del espacio
  
  // Relaciones
  transformations Transformation[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("spaces")
}

// ============================================
// MODELO: Transformation (Transformación/Proyecto)
// ============================================
model Transformation {
  id              String   @id @default(uuid())
  client          Client   // Cliente asociado
  space           Space[]  // Espacios de trabajo
  
  title           String   // Título de la transformación
  description     String?  // Descripción detallada
  
  status          String   @default("OPEN") // Valores: OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  
  priority        String   @default("MEDIUM") // Valores: LOW, MEDIUM, HIGH
  
  technology      Technology? // Tecnología asociada
  documents       Document[] // Documentos asociados
  
  user            User[]             @relation("TransformationUser")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime? @unique // Solo una transformación puede estar completada en un mismo timestamp
  
  @@map("transformations")
}

// ============================================
// MODELO: Payment (Pago)
// ============================================
model Payment {
  id              String   @id @default(uuid())
  client          Client   @relation(fields: [clientId], references: [id])
  
  amount          Float    // Monto del pago
  currency        String   @default("USD") // Moneda
  
  status          String   @default("PENDING") // Valores: PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod   String?  // Método de pago (card, bank_transfer, etc.)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("payments")
}

// ============================================
// MODELO: InventoryItem (Ítem de inventario)
// ============================================
model InventoryItem {
  id              String   @id @default(uuid())
  name            String   // Nombre del ítem
  description     String?  // Descripción
  
  quantity        Int      @default(0) // Cantidad en stock
  unitPrice       Float    // Precio por unidad
  
  sku             String?  // SKU / código de producto
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("inventory_items")
}

// ============================================
// MODELO: InventoryMovement (Movimiento de inventario)
// ============================================
model InventoryMovement {
  id              String   @id @default(uuid())
  
  type            String   // Valores: IN, OUT, ADJUSTMENT
  quantity        Int      // Cantidad
  
  reason          String?  // Razón del movimiento
  
  inventoryItemId String   // Clave foránea al ítem de inventario
  
  inventoryItem   InventoryItem @relation("InventoryItemMovements", fields: [inventoryItemId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@map("inventory_movements")
}

// ============================================
// MODELO: Supplier (Proveedor)
// ============================================
model Supplier {
  id              String   @id @default(uuid())
  name            String   // Nombre del proveedor
  email           String?  // Correo electrónico
  phone           String?  // Teléfono
  website         String?  // Sitio web
  
  address         String?  // Dirección
  city            String?  // Ciudad
  state           String?  // Estado/Provincia
  country         String?  // País
  
  notes           String?  // Notas adicionales
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("suppliers")
  
  @@index([email])
}

// ============================================
// Índices para mejorar rendimiento de consultas
// ============================================
