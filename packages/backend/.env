# ShadeX CRM Backend - Configuración Local
NODE_ENV=development
PORT=3001

# Base de datos SQLite (desarrollo local)
DATABASE_URL="file:./dev.db"

# JWT Secret (generar uno fuerte con node crypto o usar una constante segura)
JWT_SECRET="shadex-crm-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN=1h

# URL del frontend (para redirecciones y CORS)
FRONTEND_URL=http://localhost:3000