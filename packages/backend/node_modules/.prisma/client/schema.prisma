// SHADEX OS - Database Schema
// Sistema de Transformaciones Arquitectónicas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

model Client {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  email          String?
  phone          String?
  secondaryPhone String?
  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  clientType     String // VIP, Regular, New
  status         String   @default("Active") // Active, Inactive, Archived
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  transformations Transformation[]
  payments        Payment[]
  supportCases    SupportCase[]
  invoices        Invoice[]
  quotations      Quotation[]

  @@map("clients")
}

model Transformation {
  id                      String    @id @default(uuid())
  folioNumber             String    @unique
  name                    String
  clientId                String
  clientContactPerson     String?
  sector                  String // Residential, Commercial, Corporate, Industrial
  projectType             String?
  status                  String // Lead, Contacted, Survey, Quotation, FollowUp, Deposit, Scheduled, Installation, Warranty, Completed, Cancelled
  priority                String    @default("Medium") // Low, Medium, High, Urgent
  journeyPhase            String    @default("Discover") // Discover, Curate, Design, Transform, Experience
  completionPercentage    Int       @default(0)
  architectId             String?
  salesRepresentativeId   String?
  projectManagerId        String?
  country                 String?
  state                   String?
  city                    String?
  address                 String?
  coordinates             Json?
  estimatedStartDate      DateTime?
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime?
  startDate               DateTime?
  endDate                 DateTime?
  estimatedBudget         Decimal?
  approvedBudget          Decimal?
  currency                String    @default("MXN")
  actualBudget            Decimal?
  description             String?
  observations            String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?

  client        Client                     @relation(fields: [clientId], references: [id])
  architect     User?                      @relation("ArchitectTransformations", fields: [architectId], references: [id])
  technologies  TransformationTechnology[]
  quotations    Quotation[]
  installations Installation[]
  payments      Payment[]
  supportCases  SupportCase[]
  documents     Document[]
  warranty      Warranty?

  @@map("transformations")
}

model Technology {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?
  category           String // Architectural, Automotive, SmartFilm, Security, Decorative, Accessories
  subcategory        String?
  applicationType    String[] // Vehicular, Residential, Commercial, Corporate, Industrial
  costPrice          Decimal
  salePrice          Decimal
  unitOfMeasure      String // m², ml, piece, roll
  marginPercentage   Decimal
  minimumOrder       Decimal?
  manufacturer       String?
  model              String?
  specs              Json?
  performanceFactors Json?
  status             String   @default("Active") // Active, Discontinued, ComingSoon, Exclusive
  stockLevel         Int      @default(0)
  reorderPoint       Int      @default(0)
  leadTimeDays       Int      @default(7)
  supplierId         String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  supplier                   Supplier?                  @relation(fields: [supplierId], references: [id])
  inventoryItems             InventoryItem[]
  transformationTechnologies TransformationTechnology[]
  priceHistory               PriceHistory[]
  supportCases               SupportCase[]

  @@map("technologies")
}

model Supplier {
  id                 String    @id @default(uuid())
  code               String    @unique
  name               String
  taxId              String?
  businessType       String // Manufacturer, Distributor, Importer, Local
  contactPerson      String?
  email              String?
  phone              String?
  secondaryPhone     String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String?
  zipCode            String?
  paymentTerms       String? // Net30, Net45, Net60, COD, Custom
  creditLimit        Decimal?
  currentBalance     Decimal   @default(0)
  discountPercentage Decimal   @default(0)
  leadTimeDays       Int       @default(7)
  minimumOrder       Decimal?
  status             String    @default("Active") // Active, Inactive, UnderReview, Suspended
  rating             Int       @default(3)
  preferredLevel     String    @default("Standard") // Preferred, Standard, Backup
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  notes              String?
  portalEnabled      Boolean   @default(false)
  portalUsername     String?
  portalLastLogin    DateTime?
  portalPermissions  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?

  technologies   Technology[]
  evaluations    SupplierEvaluation[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String // Administrator, Architect, Sales, Installer, InventoryManager, QualityManager, SupportAgent
  phone     String?
  status    String    @default("Active") // Active, Inactive
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transformationsArchitect Transformation[] @relation("ArchitectTransformations")

  @@map("users")
}

// ============================================
// INVENTORY ENTITIES
// ============================================

model InventoryItem {
  id                String    @id @default(uuid())
  sku               String    @unique
  technologyId      String
  batchNumber       String?
  serialNumber      String?
  name              String
  description       String?
  specifications    Json?
  locationId        String?
  warehouse         String?
  zone              String?
  shelf             String?
  position          String?
  unitOfMeasure     String
  quantityOnHand    Int       @default(0)
  quantityAllocated Int       @default(0)
  quantityAvailable Int       @default(0)
  quantityOnOrder   Int       @default(0)
  reorderPoint      Int       @default(0)
  maxStock          Int?
  safetyStock       Int       @default(0)
  unitCost          Decimal
  averageCost       Decimal
  totalValue        Decimal
  manufactureDate   DateTime?
  expiryDate        DateTime?
  receivedDate      DateTime?
  lastMovementDate  DateTime?
  status            String    @default("Available") // Available, Allocated, InTransit, QualityHold, Expired, Damaged, Consumed
  condition         String    @default("New") // New, Opened, Partial, Damaged
  supplierId        String?
  purchaseOrderId   String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?

  technology  Technology          @relation(fields: [technologyId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  movements   InventoryMovement[]
  allocations Allocation[]

  @@map("inventory_items")
}

model InventoryMovement {
  id               String    @id @default(uuid())
  movementNumber   String    @unique
  inventoryItemId  String
  movementType     String // Receipt, Transfer, Allocation, Consumption, Return, Adjustment, Damage, Disposal
  direction        String // In, Out
  quantity         Int
  unitOfMeasure    String
  beforeQuantity   Int
  afterQuantity    Int
  referenceType    String? // PurchaseOrder, Installation, Project, Transfer, Adjustment, QualityCheck
  referenceId      String?
  transformationId String?
  fromLocationId   String?
  toLocationId     String?
  fromWarehouse    String?
  toWarehouse      String?
  reason           String
  description      String?
  authorizedBy     String?
  notes            String?
  unitCost         Decimal?
  totalCost        Decimal?
  valuationMethod  String? // FIFO, LIFO, AverageCost
  createdAt        DateTime  @default(now())
  createdBy        String?
  verified         Boolean   @default(false)
  verifiedBy       String?
  verifiedAt       DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("inventory_movements")
}

model Allocation {
  id               String   @id @default(uuid())
  inventoryItemId  String
  transformationId String
  quantity         Int
  unitOfMeasure    String
  allocatedDate    DateTime @default(now())
  status           String   @default("Active") // Active, Released, Consumed
  createdBy        String?
  notes            String?
  createdAt        DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("allocations")
}

// ============================================
// FINANCE ENTITIES
// ============================================

model Payment {
  id               String    @id @default(uuid())
  paymentNumber    String    @unique
  transformationId String
  quotationId      String?
  paymentType      String // Deposit, PartialPayment, FinalPayment, Refund, Adjustment
  paymentStatus    String    @default("Pending") // Pending, Completed, Failed, Cancelled, Refunded
  amount           Decimal
  currency         String    @default("MXN")
  taxAmount        Decimal   @default(0)
  totalAmount      Decimal
  remainingBalance Decimal
  paymentMethod    String // Cash, BankTransfer, CreditCard, DebitCard, Check, DigitalWallet
  paymentDetails   Json?
  paymentDate      DateTime?
  dueDate          DateTime?
  processedDate    DateTime?
  clearedDate      DateTime?
  invoiceId        String?
  invoiceStatus    String    @default("NotInvoiced") // NotInvoiced, Invoiced, InvoiceSent
  clientId         String
  payerName        String?
  payerContact     String?
  notes            String?
  receiptSent      Boolean   @default(false)
  receiptSentDate  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  verifiedBy       String?
  verifiedAt       DateTime?

  transformation Transformation @relation(fields: [transformationId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])

  @@map("payments")
}

model Invoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @unique
  uuidFiscal       String?   @unique
  transformationId String
  clientId         String
  amount           Decimal
  taxAmount        Decimal
  totalAmount      Decimal
  currency         String    @default("MXN")
  invoiceDate      DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("Draft") // Draft, Sent, Paid, Overdue, Cancelled
  paymentStatus    String    @default("Unpaid") // Unpaid, PartiallyPaid, Paid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@map("invoices")
}

model FinancialSummary {
  id                        String   @id @default(uuid())
  transformationId          String   @unique
  totalProjectAmount        Decimal
  totalPaymentsReceived     Decimal  @default(0)
  totalPendingBalance       Decimal
  totalEstimatedCosts       Decimal
  estimatedMargin           Decimal
  paymentProgressPercentage Decimal  @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("financial_summaries")
}

// ============================================
// SUPPORT ENTITIES
// ============================================

model SupportCase {
  id                    String    @id @default(uuid())
  caseNumber            String    @unique
  transformationId      String
  warrantyId            String?
  installationId        String?
  technologyId          String?
  caseType              String // WarrantyIssue, DefectiveMaterial, InstallationProblem, CustomerDissatisfaction, ReworkRequest, PaymentDispute, TechnicalIssue, QualityIssue
  severity              String // Low, Medium, High, Critical
  priority              String // Low, Medium, High, Urgent
  category              String? // Peeling, Bubbles, Scratches, ColorMismatch, PerformanceIssue, InstallationError, DeliveryIssue, Other
  title                 String
  description           String
  reportedBy            String // Client, Installer, Architect, ProjectManager, Quality
  reportedDate          DateTime  @default(now())
  locationProblem       String?
  clientId              String
  clientContact         String?
  clientPriority        String    @default("Regular") // VIP, Regular, New
  status                String    @default("Open") // Open, Investigating, InProgress, WaitingCustomer, WaitingMaterial, Resolved, Closed, Escalated
  resolutionStatus      String    @default("NotStarted") // NotStarted, Diagnosing, AwaitingApproval, Scheduled, InProgress, Completed, Verified
  rootCause             String?
  resolutionDescription String?
  resolutionMethod      String? // Replacement, Repair, Refund, CreditNote, NoActionRequired, Education
  resolutionCost        Decimal   @default(0)
  warrantyClaim         Boolean   @default(false)
  warrantyApproved      Boolean   @default(false)
  warrantyCoverage      String? // FullCoverage, PartialCoverage, NoCoverage
  assignedTo            String?
  assignedTeam          String? // Installation, Quality, Sales, Management
  assignedDate          DateTime?
  targetResolutionDate  DateTime?
  actualResolutionDate  DateTime?
  firstResponseDate     DateTime?
  slaDueDate            DateTime?
  customerImpact        String // Low, Medium, High
  businessImpact        String // Low, Medium, High
  revenueAtRisk         Decimal   @default(0)
  reputationRisk        String // Low, Medium, High
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdBy             String?
  closedBy              String?
  closedAt              DateTime?
  totalTimeToResolve    Int? // hours
  satisfactionRating    Int? // 1-5
  lessonsLearned        String?
  preventiveActions     String?

  transformation Transformation      @relation(fields: [transformationId], references: [id])
  client         Client              @relation(fields: [clientId], references: [id])
  technology     Technology?         @relation(fields: [technologyId], references: [id])
  activities     SupportActivity[]
  attachments    SupportAttachment[]

  @@map("support_cases")
}

model SupportActivity {
  id              String   @id @default(uuid())
  supportCaseId   String
  activityType    String // Call, Email, Visit, TechnicalInspection, Resolution, FollowUp
  description     String
  performedBy     String?
  performedAt     DateTime @default(now())
  durationMinutes Int?
  location        String?
  createdAt       DateTime @default(now())

  supportCase SupportCase @relation(fields: [supportCaseId], references: [id])

  @@map("support_activities")
}

model SupportAttachment {
  id            String   @id @default(uuid())
  supportCaseId String
  fileType      String // Photo, Video, Document
  fileName      String
  filePath      String
  description   String?
  uploadedBy    String?
  uploadedAt    DateTime @default(now())
  fileSize      Int?

  supportCase SupportCase @relation(fields: [supportCaseId], references: [id])

  @@map("support_attachments")
}

// ============================================
// TRANSFORMATION ENTITIES
// ============================================

model TransformationTechnology {
  id               String   @id @default(uuid())
  transformationId String
  technologyId     String
  quantity         Decimal
  unitOfMeasure    String
  notes            String?
  createdAt        DateTime @default(now())

  transformation Transformation @relation(fields: [transformationId], references: [id])
  technology     Technology     @relation(fields: [technologyId], references: [id])

  @@unique([transformationId, technologyId])
  @@map("transformation_technologies")
}

model Quotation {
  id               String    @id @default(uuid())
  quotationNumber  String    @unique
  transformationId String?
  clientId         String?
  version          Int       @default(1)
  status           String    @default("Draft") // Draft, Sent, Accepted, Rejected, Expired
  subtotal         Decimal   @default(0)
  taxPercent       Decimal   @default(16)
  taxAmount        Decimal   @default(0)
  totalAmount      Decimal   @default(0)
  currency         String    @default("MXN")
  validUntil       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  transformation Transformation? @relation(fields: [transformationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  lines          QuotationLine[]

  @@map("quotations")
}

model QuotationLine {
  id          String   @id @default(uuid())
  quotationId String
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@map("quotation_lines")
}

model Sequence {
  key  String @id
  last Int    @default(0)

  @@map("sequences")
}

model Installation {
  id                 String    @id @default(uuid())
  installationNumber String    @unique
  transformationId   String
  scheduledDate      DateTime
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  status             String    @default("Scheduled") // Scheduled, InProgress, Completed, Cancelled
  installerId        String?
  address            String?
  materials          Json?
  quantity           Decimal?
  unitOfMeasure      String?
  startTime          String?
  endTime            String?
  notes              String?
  photographs        String[] // array of file paths
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transformation Transformation @relation(fields: [transformationId], references: [id])

  @@map("installations")
}

model Warranty {
  id               String   @id @default(uuid())
  warrantyNumber   String   @unique
  transformationId String   @unique
  type             String // Architectural, Automotive, SmartFilm
  startDate        DateTime @default(now())
  endDate          DateTime
  coverage         String // Full, Partial
  terms            String?
  documentPath     String?
  status           String   @default("Active") // Active, Expired, Void
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transformation Transformation @relation(fields: [transformationId], references: [id])

  @@map("warranties")
}

model Document {
  id               String   @id @default(uuid())
  transformationId String
  documentType     String // Photo, Video, Invoice, Contract, Warranty, Sketch, PDF, Other
  fileName         String
  filePath         String
  description      String?
  uploadedBy       String?
  uploadedAt       DateTime @default(now())
  fileSize         Int?

  transformation Transformation @relation(fields: [transformationId], references: [id])

  @@map("documents")
}

// ============================================
// SUPPORTING ENTITIES
// ============================================

model PriceHistory {
  id           String   @id @default(uuid())
  technologyId String
  oldPrice     Decimal
  newPrice     Decimal
  changeDate   DateTime @default(now())
  reason       String?
  authorizedBy String?

  technology Technology @relation(fields: [technologyId], references: [id])

  @@map("price_history")
}

model SupplierEvaluation {
  id             String   @id @default(uuid())
  supplierId     String
  evaluationDate DateTime @default(now())
  evaluatorId    String?
  qualityScore   Int // 1-5
  deliveryScore  Int // 1-5
  priceScore     Int // 1-5
  serviceScore   Int // 1-5
  overallScore   Int // 1-5
  comments       String?
  recommendation String? // Continue, Review, Terminate

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_evaluations")
}
