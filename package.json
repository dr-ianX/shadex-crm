{
  "name": "shadex-os",
  "version": "1.0.0",
  "description": "SHADEX OS - Sistema de Transformaciones Arquitectónicas",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd packages/backend && npm run build",
    "build:frontend": "cd packages/frontend && npm run build",
    "start": "cd packages/backend && npm start",
    "prisma:generate": "cd packages/backend && npx prisma generate",
    "prisma:migrate": "cd packages/backend && npx prisma migrate dev",
    "prisma:studio": "cd packages/backend && npx prisma studio",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^7.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "esbuild@0.28.1": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "dependencies": {
    "@prisma/client": "^7.9.0"
  }
}
