# Environment Variables for Render.com Production
# SHADEX OS - Sistema de Transformaciones Arquitectónicas

# Application
NODE_ENV=production
PORT=3001

# Database (Render provides this automatically)
# DATABASE_URL will be set by Render from the PostgreSQL service

# JWT Secrets (Render will generate these)
# JWT_SECRET will be generated by Render
# JWT_REFRESH_SECRET will be generated by Render

# File Upload
UPLOAD_DIR=/opt/render/project/uploads
MAX_FILE_SIZE=10485760

# Frontend URL
FRONTEND_URL=https://shadex-frontend.onrender.com

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Google Maps API (optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Application URLs
ALLOWED_ORIGINS=https://shadex-frontend.onrender.com,https://shadex-backend.onrender.com